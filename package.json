{
  "name": "homework-board",
  "version": "1.0.0",
  "description": "Local board that pulls homework out of school systems onto one page",
  "main": "index.js",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "prestart": "npm run verify",
    "start": "node server.mjs",
    "verify": "npm run lockfile:check && npm run lint && npm test && npm run audit && npm audit signatures",
    "test": "node --test \"test/*.test.mjs\"",
    "test:watch": "node --test --watch \"test/*.test.mjs\"",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "audit": "npm audit --omit=dev --audit-level=high",
    "lockfile:check": "lockfile-lint --path npm-shrinkwrap.json --type npm --allowed-hosts npm --validate-https"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "express": "5.2.1",
    "playwright": "1.63.0"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "eslint": "9.39.5",
    "globals": "15.15.0",
    "lockfile-lint": "4.14.1"
  },
  "private": true
}
